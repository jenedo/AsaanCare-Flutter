# Normalize text files across Windows, Linux, and macOS.
* text=auto

# Source code and configuration files use LF inside Git.
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.sh text eol=lf

# Windows scripts use CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
